{
	"name": "izgah",
	"version": "0.1.0",
	"description": "Self-hosted shared link library for small teams.",
	"license": "AGPL-3.0-only",
	"homepage": "https://izgah.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/gorkemio/izgah.git"
	},
	"bugs": {
		"url": "https://github.com/gorkemio/izgah/issues"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/build-server-tools.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:docker": "docker build -t izgah-core:test . && PLAYWRIGHT_DOCKER_SMOKE=1 playwright test tests/e2e/m8-docker-smoke.spec.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"cli": "node --import 'data:text/javascript,import{registerHooks}from\"node:module\";registerHooks({resolve(s,c,n){return s===\"$app/environment\"?{shortCircuit:true,url:\"data:text/javascript,export const building=false,dev=true,browser=false,version=0;\"}:n(s,c);}})' --import tsx src/cli.ts"
	},
	"dependencies": {
		"better-auth": "^1.2.0",
		"drizzle-orm": "^0.45.2",
		"htmlparser2": "^10.0.0",
		"postgres": "^3.4.0",
		"sharp": "^0.33.0",
		"undici": "^7.0.0",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^9.0.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@playwright/test": "^1.50.0",
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^22.0.0",
		"drizzle-kit": "^0.31.4",
		"esbuild": "^0.25.0",
		"eslint": "^9.0.0",
		"eslint-plugin-svelte": "^2.46.0",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^3.3.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	}
}
