{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": ["pnpm-lock.yaml", "AGENTS.md", "concepts_brief.md", "docs/**/*.md", "drizzle/**"],
			"options": {
				"requirePragma": true
			}
		}
	]
}
