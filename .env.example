# PostgreSQL connection string for application runtime
DATABASE_URL="postgresql://izgah:izgah@127.0.0.1:5432/izgah"

# Dedicated PostgreSQL connection string for integration tests (database name must be izgah_test)
TEST_DATABASE_URL="postgresql://izgah:izgah@127.0.0.1:5432/izgah_test"

# Maximum number of connections in the PostgreSQL pool
DATABASE_POOL_MAX="12"

# Session signing secret (required, minimum 32 characters)
BETTER_AUTH_SECRET="replace-with-at-least-32-char-random-secret"

# Public origin URL (required in production for CSRF checks and invite/reset links)
ORIGIN="http://localhost:3000"

# HTTP server bind address and port
HOST="0.0.0.0"
PORT="3000"

# Reverse proxy client IP forwarding settings for @sveltejs/adapter-node
ADDRESS_HEADER="x-forwarded-for"
XFF_DEPTH="1"

# Persistent local thumbnail cache directory and disk-space thresholds
MEDIA_STORAGE_DIR="./.local-data/thumbnails"
MEDIA_MIN_FREE_BYTES="536870912"
MEDIA_MIN_FREE_RATIO="0.15"

# Optional initial admin bootstrap email (used only when no active admin exists)
ADMIN_BOOTSTRAP_EMAIL=""

# Optional GitHub token for repository metadata requests. Use a fine-grained token with
# public-repository read access only: any member can share a repo link, so a token that can
# read private repositories would expose their names and descriptions to your team.
GITHUB_TOKEN=""

# Background unfurl worker concurrency and structured log verbosity (debug|info|warn|error)
UNFURL_CONCURRENCY="3"
LOG_LEVEL="info"

# Instance settings (docs/designs/izgah-i18n-oss.md §6)
# Default UI language for members who have not chosen one: en | tr
DEFAULT_LOCALE="en"
# IANA time zone for dates and "today" boundaries
APP_TIME_ZONE="UTC"
# Name shown in the sidebar, sign-in page and browser tab titles
INSTANCE_NAME="Izgah"
# Source code link shown in Settings (AGPL-3.0 §13); point it at your fork if you modify Izgah
SOURCE_URL="https://github.com/gorkemio/izgah"

# Example: a Turkish team instance
# ORIGIN="https://links.example.com"
# DEFAULT_LOCALE="tr"
# APP_TIME_ZONE="Europe/Istanbul"
# INSTANCE_NAME="İzgah"
