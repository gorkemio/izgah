{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": ["pnpm-lock.yaml", "AGENTS.md", "concepts_brief.md", "docs/**/*.md", "drizzle/**"],
			"options": {
				"requirePragma": true
			}
		}
	],
	"tailwindStylesheet": "./src/app.css",
	"tailwindFunctions": ["cn", "tv"]
}
