{
	"name": "izgah-extensions",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"postinstall": "wxt prepare",
		"dev": "wxt -b chrome",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build -b chrome",
		"build:firefox": "wxt build -b firefox",
		"build:safari": "node ./scripts/build-safari.mjs",
		"build:all": "pnpm build && pnpm build:firefox && pnpm build:safari",
		"build:store": "WXT_IZGAH_STORE_BUILD=1 wxt build -b chrome && WXT_IZGAH_STORE_BUILD=1 wxt build -b firefox && node ./scripts/verify-manifests.mjs --store --only=chrome && node ./scripts/verify-manifests.mjs --store --only=firefox",
		"zip:store": "WXT_IZGAH_STORE_BUILD=1 wxt zip -b chrome && WXT_IZGAH_STORE_BUILD=1 wxt zip -b firefox",
		"zip": "wxt zip -b chrome",
		"zip:firefox": "wxt zip -b firefox",
		"verify:manifests": "node ./scripts/verify-manifests.mjs",
		"check": "wxt prepare && tsc --noEmit",
		"lint": "eslint --max-warnings 0 . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "pnpm build && playwright test"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@playwright/test": "^1.50.0",
		"@types/node": "^22.0.0",
		"eslint": "^9.0.0",
		"jsdom": "^26.0.0",
		"prettier": "^3.4.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.0.0",
		"vite": "7.3.8",
		"vitest": "^3.0.0",
		"wxt": "^0.21.5"
	},
	"license": "AGPL-3.0-only",
	"homepage": "https://izgah.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/gorkemio/izgah.git",
		"directory": "extensions"
	}
}
