# Leave WXT_IZGAH_ORIGIN unset and set WXT_IZGAH_STORE_BUILD=1 for the public store build
# (no built-in server, no host permission). Set WXT_IZGAH_ORIGIN to build a copy for one instance.
WXT_IZGAH_STORE_BUILD=
WXT_IZGAH_ORIGIN=https://links.example.com
WXT_GECKO_ID=extension@izgah.com
SAFARI_BUNDLE_ID=com.izgah.extension
